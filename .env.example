# Database
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/agency_dashboard"

# NextAuth
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="your-secret-here-generate-with-openssl-rand-base64-32"

# Google OAuth (create at console.cloud.google.com)
GOOGLE_CLIENT_ID="your-google-client-id"
GOOGLE_CLIENT_SECRET="your-google-client-secret"

# Google Ads (apply at ads.google.com/home/tools/manager-accounts)
GOOGLE_ADS_DEVELOPER_TOKEN="your-developer-token"

# Meta (create at developers.facebook.com)
META_APP_ID="your-meta-app-id"
META_APP_SECRET="your-meta-app-secret"

# Microsoft Clarity (optional - for iframe embed)
NEXT_PUBLIC_CLARITY_PROJECT_ID="your-clarity-project-id"

# Redis (optional - for caching, use Upstash)
REDIS_URL="redis://localhost:6379"
